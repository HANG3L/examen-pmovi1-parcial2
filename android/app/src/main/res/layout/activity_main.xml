<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".vista.MainActivity">

    <LinearLayout
        android:id="@+id/raiz"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/barra"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/titulo_registro"
            app:titleTextAppearance="@style/TextAppearance.Material3.HeadlineSmall" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="20dp">

                <include layout="@layout/formulario_contacto" />

                <Button
                    android:id="@+id/btnGuardar"
                    style="@style/BotonPrincipal"
                    android:layout_width="match_parent"
                    android:layout_marginTop="20dp"
                    android:text="@string/salvar_contacto"
                    app:icon="@drawable/ic_guardar" />

                <Button
                    android:id="@+id/btnVerContactos"
                    style="@style/BotonSecundario"
                    android:layout_width="match_parent"
                    android:layout_marginTop="8dp"
                    android:text="@string/contactos_salvados"
                    app:icon="@drawable/ic_grupo" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- Indicador de carga: tapa la pantalla mientras se espera la respuesta de la API -->
    <FrameLayout
        android:id="@+id/cargando"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true" />
    </FrameLayout>
</FrameLayout>
