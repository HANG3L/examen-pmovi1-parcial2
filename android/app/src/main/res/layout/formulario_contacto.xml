<?xml version="1.0" encoding="utf-8"?>
<!-- Formulario de contacto: fotografia, nombre, telefono y ubicacion (latitud/longitud bloqueadas) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Tarjeta de la foto -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Tarjeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgFoto"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:background="?attr/colorPrimaryContainer"
                android:contentDescription="@string/foto_contacto"
                android:padding="28dp"
                android:scaleType="fitCenter"
                app:shapeAppearanceOverlay="@style/FormaCircular"
                app:srcCompat="@drawable/ic_persona"
                app:tint="?attr/colorOnPrimaryContainer" />

            <Button
                android:id="@+id/btnTomarFoto"
                style="@style/Widget.Material3.Button.TonalButton.Icon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/tomar_fotografia"
                app:icon="@drawable/ic_camara" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Tarjeta de los datos -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Tarjeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/datos_contacto"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <!-- Nombre -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoNombre"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/nombre"
                app:endIconMode="clear_text"
                app:helperText="@string/ayuda_nombre"
                app:startIconDrawable="@drawable/ic_persona">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Telefono -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoTelefono"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/telefono"
                app:counterEnabled="true"
                app:counterMaxLength="8"
                app:helperText="@string/ayuda_telefono"
                app:startIconDrawable="@drawable/ic_llamar">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:maxLength="8" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Latitud: bloqueada, la llena el GPS -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoLatitud"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/latitud"
                app:helperText="@string/ayuda_ubicacion"
                app:startIconDrawable="@drawable/ic_mundo">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtLatitud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Longitud: bloqueada, la llena el GPS -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoLongitud"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/longitud"
                app:startIconDrawable="@drawable/ic_mundo">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtLongitud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
